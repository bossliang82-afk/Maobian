{
  "name": "deckle-edge",
  "version": "1.0.0",
  "description": "毛边 (Deckle Edge) - 桌面情绪常驻便签小组件",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "keywords": [
    "widget",
    "diary",
    "mood",
    "deckle-edge"
  ],
  "author": "毛边",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.maobian.deckleedge",
    "productName": "毛边",
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false,
      "sign": false,
      "target": [
        "dir",
        "portable"
      ]
    }
  }
}
